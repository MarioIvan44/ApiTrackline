# Plantilla de variables de entorno para ApiTrackline.
# Copia este archivo como ".env" y rellena los valores reales.
#   cp .env.example .env   (Linux/Mac)
#   copy .env.example .env (Windows CMD)

# ---------- BASE DE DATOS (Oracle) ----------
BD_URL=jdbc:oracle:thin:@//host:1521/servicio
BD_USER=
BD_PASSWORD=
BD_DRIVER=oracle.jdbc.OracleDriver

# ---------- JWT ----------
SECRET_KEY_JWT=
SECURITY_JWT_ISSUER=apiTrackline
JWT_EXPIRATION=86400000

# ---------- CORREO (Gmail SMTP) ----------
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
